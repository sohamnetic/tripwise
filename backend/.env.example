# Copy to backend/.env and fill in.
# Keep DEMO_MODE=true while developing so no paid API quota is used.
DEMO_MODE=true

# https://serpapi.com  (free tier: 250 searches/month)
SERPAPI_KEY=
# Live searches allowed per day, so one busy day can't use up the month (250 / 30 ≈ 8).
# Past it, trips use saved results and typical-price estimates. 0 = no daily cap.
SERPAPI_DAILY_LIMIT=8
# Per visitor per 24 hours: new trips, and all planning requests (replans included).
VISITOR_DAILY_TRIPS=5
VISITOR_DAILY_REQUESTS=40

# https://myprojects.geoapify.com  (free: 3,000 credits/day, no card)
# Restaurants and beaches from OpenStreetMap when Google results aren't available.
GEOAPIFY_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
